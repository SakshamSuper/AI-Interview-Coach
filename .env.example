# ==============================================================================
# AI INTERVIEW COACH - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application
APP_NAME=AI Interview Coach
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=8501

# LLM Provider Configuration (Options: groq, openai, local_mock)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_DIR=data/knowledge_base/faiss_index
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
SIMILARITY_THRESHOLD=0.60

# Database
DATABASE_URL=sqlite:///./data/interview_coach.db

# Machine Learning Paths
ML_MODEL_PATH=ml/models/interview_readiness_rf.joblib
ML_SCALER_PATH=ml/models/readiness_scaler.joblib

# File & Privacy Paths
UPLOAD_DIR=data/uploads
TEMP_MEDIA_DIR=data/temp_media
