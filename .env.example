# ==============================================================================
# AI INTERVIEW COACH - BACKEND PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and supply your credentials. Do NOT commit .env!
# ==============================================================================

# --- Core Application ---
APP_NAME=AI Interview Coach
APP_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# --- LLM Provider Configuration ---
# Options: groq, openai, local_mock
LLM_PROVIDER=groq
# Recommended Groq models: openai/gpt-oss-120b, qwen/qwen3.8-27b, llama-3.3-70b-versatile
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# --- Authentication & CORS ---
# NEXTAUTH_SECRET: generate via `openssl rand -hex 32` (Must match frontend exactly)
NEXTAUTH_SECRET=
# CORS_ORIGINS: Comma-separated list of allowed frontend domains (e.g. https://my-app.vercel.app)
# Use * only in development
CORS_ORIGINS=http://localhost:3000,https://my-app.vercel.app

# --- Database Configuration ---
# Production SQLite on Render persistent disk mount: sqlite:////var/data/interview_coach.db
# Or external PostgreSQL: postgresql+psycopg2://user:password@host:5432/interview_coach
DATABASE_URL=sqlite:///./data/interview_coach.db

# --- RAG & FAISS Vector Store ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_DIR=data/knowledge_base/faiss_index
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
SIMILARITY_THRESHOLD=0.25

# --- Machine Learning Paths ---
ML_MODEL_PATH=ml/models/interview_readiness_rf.joblib
ML_SCALER_PATH=ml/models/readiness_scaler.joblib

# --- Storage & Temporary Files ---
UPLOAD_DIR=data/uploads
TEMP_MEDIA_DIR=data/temp_media

# --- Voice / Audio STT (faster-whisper) ---
# Models: tiny (~75 MB, recommended for 512MB-1GB RAM tiers), base (~145 MB), small (~465 MB)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
